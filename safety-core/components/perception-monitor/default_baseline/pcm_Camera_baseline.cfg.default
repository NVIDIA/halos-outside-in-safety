#
# Reference default: loading-dock-3-cameras, sensor Camera.
# Profile: ATL zone 1 + forklift-person PXC, using
# proximity_event_mapping.pb.txt, atl_sdm_zone1.conf and pxc_sdm_forklift.conf.
# Captured with nv_perception_monitor --mode LEARN for 300 seconds,
# 2026-10-08 09:54:28 to 09:59:28 UTC.
# For other deployments or SDM profiles, run LEARN;
# pcm_Camera_baseline.cfg takes precedence over this template.

# PCM decision-data baseline; generated by --mode LEARN
[dvm_baseline]
schema_version = 2
known_sensor = Camera
expected_fps = 29.910269192422732
max_frame_age_ms = 2000
decision_contract = 1
proximity_required = 1
proximity_threshold = 4
pair_rule = forklift person 2
roi_rule = roi-id-1 person restricted
