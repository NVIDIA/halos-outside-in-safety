# SRR pipeline configuration. Copy to `.env` and fill in your deployment paths.
# Shared values (HOST_IP, ROS_DOMAIN_ID, VST_BASE_URL, MDX_DATA_DIR, ...) are
# inherited from $HALOS_ENV_FILE (the Halos profile env) — don't duplicate here.

# SRR now lives INSIDE the Halos repo (closed-loop-testing/regression-reporter/),
# so the three HALOS_* paths below point at sibling dirs of this repo. Use absolute
# paths (they are sourced from more than one working dir — run_multi.sh vs compose).

# REQUIRED: Halos deployment front-door (holds compose.yaml + profiles/<profile>.env).
# In-repo: <repo>/deployments
HALOS_COMPOSE_DIR=/path/to/halos-outside-in-safety/deployments

# REQUIRED: Halos profile env carrying the shared infra values above
# (HOST_IP, ROS_DOMAIN_ID, VST_BASE_URL, ...). In-repo: <repo>/deployments/profiles/<profile>.env
HALOS_ENV_FILE=/path/to/halos-outside-in-safety/deployments/profiles/sil.env

# REQUIRED: Isaac SIL asset tree the isaac-sim container bind-mounts at /isaac-sim/sil
# (scenes/configs/scripts). sync_to_halos.sh copies SRR fixtures into it.
# In-repo: <repo>/closed-loop-testing/isaac-sim/sil
HALOS_SIL_DIR=/path/to/halos-outside-in-safety/closed-loop-testing/isaac-sim/sil

# REQUIRED: VSS calibration JSON (host path; mounts into SRR container).
# Loaded by srr.aggregator and srr.tw_split for ROI polygon and tripwire X.
CALIBRATION_JSON=/path/to/vss-warehouse/.../warehouse-loading-dock-3cams-synthetic/calibration.json

# Where SRR test outputs land. Default: <repo>/srr-service/runs (gitignored).
# RUNS_HOST_DIR=./srr-service/runs

# OPTIONAL: host bind-mount of the safety-core container's /var/log/pss.log.
# snapshot_pss.sh + clip_logs.py read it to attach PSF internal-state evidence.
# Point at your <sil-data>/psf-log/pss.log; leave unset to skip the PSF log slice.
# PSS_LOG_SRC=/path/to/sil-data/psf-log/pss.log
# SIL_DATA_DIR=/path/to/sil-data

# VSS sensor names — must match the deployed scene topology.
# These are NOT in calibration.json, hence configured here.
SENSORS=Camera,Camera_01,Camera_02

# Kafka topic the SRR consumer reads from (matches VSS perception output).
KAFKA_TOPIC=mdx-events
