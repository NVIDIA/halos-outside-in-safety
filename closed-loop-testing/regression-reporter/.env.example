# SRR pipeline configuration. Copy to `.env` and fill in your deployment path.
# Shared values (HOST_IP, ROS_DOMAIN_ID, VST_BASE_URL, MDX_DATA_DIR, ...) are
# inherited from the deployment profile env under
# $HOISA_ROOT_PATH/deployments/profiles/ — don't duplicate them here.

# SRR lives INSIDE the repo (closed-loop-testing/regression-reporter/), so one
# absolute path to the repo root is all the plumbing needs. The deployment dir,
# profile env, and Isaac SIL tree all derive from it:
#   deployment front-door : $HOISA_ROOT_PATH/deployments  (compose.yaml + profiles/)
#   profile env (shared)  : $HOISA_ROOT_PATH/deployments/profiles/sil.env
#   Isaac SIL asset tree  : $HOISA_ROOT_PATH/closed-loop-testing/isaac-sim/sil
#                           (isaac-sim bind-mounts it at /isaac-sim/sil;
#                            sync_to_halos.sh copies SRR fixtures into it)
# REQUIRED: absolute path to the halos-outside-in-safety repo root.
HOISA_ROOT_PATH=/path/to/halos-outside-in-safety

# REQUIRED: VSS calibration JSON (host path; mounts into SRR container).
# Loaded by srr.aggregator and srr.tw_split for ROI polygon and tripwire X.
CALIBRATION_JSON=/path/to/video-search-and-summarization/deploy/docker/industry-profiles/warehouse-operations/warehouse-3d-app/calibration/sample-data/warehouse-loading-dock-3cams-synthetic-3d/calibration.json

# Where SRR test outputs land. Default: <repo>/srr-service/runs (gitignored).
# RUNS_HOST_DIR=./srr-service/runs

# OPTIONAL: host bind-mount of the safety-core container's /var/log/pss.log.
# snapshot_pss.sh + clip_logs.py read it to attach Safety Core internal-state evidence.
# Point at your <sil-data>/psf-log/pss.log; leave unset to skip the Safety Core log slice.
# PSS_LOG_SRC=/path/to/sil-data/psf-log/pss.log
# SIL_DATA_DIR=/path/to/sil-data

# VSS sensor names — must match the deployed scene topology.
# These are NOT in calibration.json, hence configured here.
SENSORS=Camera,Camera_01,Camera_02

# Kafka topic the SRR consumer reads from (matches VSS perception output).
KAFKA_TOPIC=mdx-events
