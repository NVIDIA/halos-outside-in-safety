    over "PatrolHumaniods" (
        active = false
    )
    {
        over "AgilityDigit_Patrol"
        {
            over "ActionGraph"
            {
                over "make_array"
                {
                    custom token inputs:input0
                    delete token inputs:input0.connect = </World/PatrolHumaniods/AgilityDigit_Patrol/ActionGraph/constant_float3_01.inputs:value>
                    prepend token inputs:input0.connect = </World/PatrolHumaniods/AgilityDigit_Patrol/ActionGraph/constant_float3_01.inputs:value>
                    custom token inputs:input1
                    delete token inputs:input1.connect = </World/PatrolHumaniods/AgilityDigit_Patrol/ActionGraph/constant_float3.inputs:value>
                    prepend token inputs:input1.connect = </World/PatrolHumaniods/AgilityDigit_Patrol/ActionGraph/constant_float3.inputs:value>
                }

                over "write_prim_attribute_02"
                {
                    custom token inputs:value (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string resolvedType = "bool"
                                }
                            }
                        }
                    )
                }
            }

            over "offset"
            {
                over "Biped_Demo"
                {
                    over "Root"
                    {
                        custom rel inputs:pose
                        custom float PatrolLookAroundTime = 10
                        custom bool PatrolStart = 1
                        custom float3[] PatrolTargetPoints = [(-0.5, -11, 0), (-3.5, -9, 0)]
                    }
                }
            }

            over "Biped_Setup_slow_4"
            {
                over "biped_demo_meters"
                {
                    custom rel inputs:pose
                }
            }
        }

        over "GR1_T2_Patrol"
        {
            over "ActionGraph"
            {
                over "make_array"
                {
                    custom token inputs:input0
                    delete token inputs:input0.connect = </World/PatrolHumaniods/GR1_T2_Patrol/ActionGraph/constant_float3_01.inputs:value>
                    prepend token inputs:input0.connect = </World/PatrolHumaniods/GR1_T2_Patrol/ActionGraph/constant_float3_01.inputs:value>
                    custom token inputs:input1
                    delete token inputs:input1.connect = </World/PatrolHumaniods/GR1_T2_Patrol/ActionGraph/constant_float3.inputs:value>
                    prepend token inputs:input1.connect = </World/PatrolHumaniods/GR1_T2_Patrol/ActionGraph/constant_float3.inputs:value>
                }

                over "write_prim_attribute_02"
                {
                    custom token inputs:value (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string resolvedType = "bool"
                                }
                            }
                        }
                    )
                }
            }

            over "Biped_Demo"
            {
                over "Root"
                {
                    custom rel inputs:pose
                    custom float PatrolLookAroundTime = 12
                    custom bool PatrolStart = 1
                    custom float3[] PatrolTargetPoints = [(3, -16, 0), (3, -13, 0)]
                }
            }

            over "Biped_Setup_slow_4"
            {
                over "biped_demo_meters"
                {
                    custom rel inputs:pose
                }
            }
        }
    }

