        def OmniGraphNode "script_node_SwivelIK" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom double inputs:angular_z
            delete double inputs:angular_z.connect = [
                </World/ActionGraph/script_node_playback.outputs:angular_z>,
                </World/ActionGraph/break_3_vector_01.outputs:z>,
            ]
            prepend double inputs:angular_z.connect = </World/ActionGraph/script_node_playback.outputs:angular_z>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            uint inputs:execIn.connect = </World/ActionGraph/on_playback_tick.outputs:tick>
            custom double inputs:linear_x
            delete double inputs:linear_x.connect = [
                </World/ActionGraph/script_node_playback.outputs:linear_x>,
                </World/ActionGraph/break_3_vector.outputs:x>,
            ]
            prepend double inputs:linear_x.connect = </World/ActionGraph/script_node_playback.outputs:linear_x>
            custom string inputs:script = """import math

MAX_STEER = math.radians(45.0)
MIN_COS = 1e-3
MIN_SPEED = 1e-4

def compute(db):
    linear_x = -db.inputs.linear_x
    angular_z = db.inputs.angular_z
    angular_z = -angular_z
    wheelbase = db.inputs.wheelbase

    
    heading_speed = max(abs(linear_x), MIN_SPEED)
    steer = math.atan2(angular_z * wheelbase, heading_speed)
    steer = max(min(steer, MAX_STEER), -MAX_STEER)

    # when reversing, may want to invert steering direction (optional)
    if linear_x < 0.0:
        steer = 0.0 if abs(angular_z) < MIN_SPEED else -steer
        drive = -heading_speed / max(math.cos(steer), MIN_COS)
    else:
        drive = heading_speed / max(math.cos(steer), MIN_COS)

    db.outputs.drive_velocity = drive
    db.outputs.steering_angle = steer
    return True"""
            custom token inputs:scriptPath
            custom bool inputs:usePath = 0
            custom double inputs:wheelbase
            double inputs:wheelbase.connect = </World/ActionGraph/constant_double_wheelbase.inputs:value>
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom double outputs:drive_velocity
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:steering_angle
            custom bool state:omni_initialized
            uniform token ui:nodegraph:node:expansionState = "open"
