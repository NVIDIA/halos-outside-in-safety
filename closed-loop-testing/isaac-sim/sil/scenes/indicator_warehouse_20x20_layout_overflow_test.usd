                        over "omni_kit_widget_viewport_ViewportTexture_0_CrossCorrespondenceDisplayPostCombine"
                        {
                            custom float3 inputs:parameters = (0, 0, -100)
                        }
                    }
                }
            }
        }
    }

    def RenderSettings "OmniverseGlobalRenderSettings" (
        prepend apiSchemas = ["OmniRtxSettingsGlobalRtAdvancedAPI_1", "OmniRtxSettingsGlobalPtAdvancedAPI_1"]
        no_delete = true
    )
    {
        rel products = [
            </Render/OmniverseKit/HydraTextures/omni_kit_widget_viewport_ViewportTexture_0>,
            </Render/OmniverseKit/HydraTextures/Replicator>,
            </Render/OmniverseKit/HydraTextures/Replicator_01>,
            </Render/OmniverseKit/HydraTextures/Replicator_02>,
            </Render/OmniverseKit/HydraTextures/Replicator_03>,
        ]
    }

    def "Vars"
    {
        def RenderVar "LdrColor" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            uniform string sourceName = "LdrColor"
        }
    }
}

def Scope "Replicator"
{
    def OmniGraph "SDGPipeline"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        custom int64 graph:variable:globalSeed (
            customData = {
                token scope = "private"
            }
            displayName = "globalSeed"
        )
        token pipelineStage = "pipelineStageSimulation"
    }
}

over "Root" (
    active = false
)
{
    over "ActionGraph" (
        active = false
    )
    {
        over "MakePosArray"
        {
            custom token inputs:input0
            delete token inputs:input0.connect = </World/ActionGraph/constant_double_zero.inputs:value>
            prepend token inputs:input0.connect = </World/ActionGraph/constant_double_zero.inputs:value>
            custom token inputs:input1
            delete token inputs:input1.connect = </World/ActionGraph/script_node_SwivelIK.outputs:steering_angle>
            prepend token inputs:input1.connect = </World/ActionGraph/script_node_SwivelIK.outputs:steering_angle>
        }

        over "MakeJointNames"
        {
            custom token inputs:input0
            delete token inputs:input0.connect = </World/ActionGraph/constant_token.inputs:value>
            prepend token inputs:input0.connect = </World/ActionGraph/constant_token.inputs:value>
            custom token inputs:input1
            delete token inputs:input1.connect = </World/ActionGraph/constant_token_01.inputs:value>
            prepend token inputs:input1.connect = </World/ActionGraph/constant_token_01.inputs:value>
        }

        over "MakeVelArray"
        {
            custom token inputs:input1
            delete token inputs:input1.connect = </World/ActionGraph/constant_double_zero.inputs:value>
            prepend token inputs:input1.connect = </World/ActionGraph/constant_double_zero.inputs:value>
        }
    }
}

