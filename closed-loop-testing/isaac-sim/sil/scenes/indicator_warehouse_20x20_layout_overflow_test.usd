        def OmniGraphNode "script_node" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ActionGraph/ros2_subscriber.outputs:execOut>
            custom bool inputs:is_muted
            prepend bool inputs:is_muted.connect = </World/ActionGraph/ros2_subscriber.outputs:data>
            custom string inputs:script = '''from pxr import UsdGeom, Gf
import omni.usd

def compute(db):
    stage = omni.usd.get_context().get_stage()
    disk_path = "/World/forklift_b/body/body/safety_indicator"
    
    disk_prim = stage.GetPrimAtPath(disk_path)
    if disk_prim.IsValid():
        mesh = UsdGeom.Mesh(disk_prim)
        color_attr = mesh.GetDisplayColorAttr()
        
        if db.inputs.is_muted:
            # GREEN - safety muted (loading allowed)
            color_attr.Set([Gf.Vec3f(0.0, 1.0, 0.0)])
        else:
            # RED/ORANGE - alarm active
            color_attr.Set([Gf.Vec3f(1.0, 0.3, 0.0)])
    
    return True'''
            custom token inputs:scriptPath
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom bool state:omni_initialized
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (669.8741, 777.00476)
        }

        def OmniGraphNode "script_node_playback" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ActionGraph/on_playback_tick.outputs:tick>
            custom string inputs:script = """\"\"\"
OmniGraph Script Node - Forklift Playback

Input:  sim_time (double) ← On Playback Tick.time
Output: linear_x, angular_z (double), segment_index (int), finished (bool)
\"\"\"

import os
import json

SEGMENTS_FILE = os.environ.get(
    \"PLAYBACK_SEGMENTS_FILE\",
    \"/isaac-sim/sil/playback/segments.json\"
)
# ============ EDIT HERE ============
SEGMENTS_FALLBACK = [
    # (duration_sec, linear_x, angular_z, note)
    (16.0, 1.0, 0.0, \"Forward\"),
    (5.0, 0.0, 0.0, \"Idle\"),
    (16.0, -1.0, 0.0, \"Backward\"),
    (5.0, 0.0, 0.0, \"Idle\"),
]
LOOP = True
FLIP_LINEAR = False
FLIP_ANGULAR = True
# ===================================
def load_segments(filepath):
    \"\"\"Load segments from JSON file, return list of tuples.\"\"\"
    import json
    if not os.path.exists(filepath):
        print(f\"[Playback] File not found: {filepath}\")
        return None
    try:
        with open(filepath) as f:
            data = json.load(f)
        segments = [(s[\"duration\"], s[\"linear_x\"], s[\"angular_z\"], s.get(\"note\", \"\")) for s in data[\"segments\"]]
        print(f\"[Playback] Loaded {len(segments)} segments from {filepath}\")
        for i, (dur, lx, az, note) in enumerate(segments):
            print(f\"  [{i}] {dur}s: linear={lx}, angular={az} ({note})\")
        return segments
    except Exception as e:
        print(f\"[Playback] {e}\")
        return None

SEGMENTS = load_segments(SEGMENTS_FILE) if SEGMENTS_FILE else None
if not SEGMENTS:
    SEGMENTS = SEGMENTS_FALLBACK
    print(f\"[Playback] Warning: SEGMENTS was empty, using fallback\")


def setup(db):
    state = db.internal_state
    state.segment_index = 0
    state.segment_elapsed = 0.0
    state.prev_time = -1.0
    state.finished = False


def cleanup(db):
    setup(db)


def compute(db):
    state = db.internal_state
    sim_time = db.inputs.sim_time

    # Calculate delta time from previous tick
    if state.prev_time < 0:
        dt = 0.0
    else:
        dt = sim_time - state.prev_time

    # Detect timeline reset (Stop then Play again)
    if dt < -0.01:
        state.segment_index = 0
        state.segment_elapsed = 0.0
        state.finished = False
        dt = 0.0

    state.prev_time = sim_time

    # Check if finished or out of segments
    if state.finished or state.segment_index >= len(SEGMENTS):
        if LOOP:
            state.segment_index = 0
            state.segment_elapsed = 0.0
        else:
            state.finished = True
            db.outputs.linear_x = 0.0
            db.outputs.angular_z = 0.0
            db.outputs.segment_index = state.segment_index
            db.outputs.finished = True
            return True

    # Get current segment
    duration, linear_x, angular_z, note = SEGMENTS[state.segment_index]
    
    # Print when segment changes
    if not hasattr(state, 'last_printed_idx') or state.last_printed_idx != state.segment_index:
        print(f\"[Playback] Segment {state.segment_index}: {note} ({duration}s, linear={linear_x}, angular={angular_z})\")
        state.last_printed_idx = state.segment_index

    # Apply flips if needed
    if FLIP_LINEAR:
        linear_x = -linear_x
    if FLIP_ANGULAR:
        angular_z = -angular_z

    # Accumulate elapsed time
    state.segment_elapsed += dt

    # Move to next segment when duration exceeded
    if state.segment_elapsed >= duration:
        state.segment_index += 1
        state.segment_elapsed = 0.0

    # Set outputs
    db.outputs.linear_x = linear_x
    db.outputs.angular_z = angular_z
    db.outputs.segment_index = state.segment_index
    db.outputs.finished = False
    return True
"""
            custom token inputs:scriptPath
            custom double inputs:sim_time
            prepend double inputs:sim_time.connect = </World/ActionGraph/on_playback_tick.outputs:time>
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom double outputs:angular_z
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:linear_x
            custom bool state:omni_initialized
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (281.5919, 445.41476)
        }
