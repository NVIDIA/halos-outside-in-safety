.claude

# Python
__pycache__/
*.pyc

# Deploy-flow runtime artifacts — carry LIVE credentials (NGC_CLI_API_KEY, etc.)
# and resolved compose state. Never commit.
**/generated.env
**/*.run.env
deploy/docker/resolved.yml

# Forklift prims generated from the robots.yaml spawn: blocks on every launch.
# Its own directory, so the bit that makes it writable by the container user
# never lands on scenes/, which holds the tracked USDs.
# See closed-loop-testing/isaac-sim/sil/scripts/forklift_overlay.py
**/scenes/generated/

# Logs / run data
*.log
data_log/

# Jupyter
**/.ipynb_checkpoints/
