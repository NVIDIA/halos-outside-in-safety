# SIL profile — x86 single-host, everything in Docker (incl. PSF x86). Self-contained.
# Usage:  cd deployments && docker compose --env-file profiles/sil.env up -d

COMPOSE_PROFILES=sil
# Two-forklift toggle: swap the line above for the one below, AND launch Isaac
# with the 2FL config pair (both flags together — no file edits needed):
#   ./run_sdg.sh -c /isaac-sim/sil/configs/default_config_ros_2fl.yaml \
#     --robots-config /isaac-sim/sil/configs/robots-2fl.yaml ...
#COMPOSE_PROFILES=sil,multi-robot

# Controller topics are namespaced per robot; ROBOT_ID must match the
# robots.yaml block name and the prim leaf name (applies in both fleet modes).
FORKLIFT_ROBOT_ID=forklift_b
FORKLIFT_USE_NAMESPACE=true

# Which warehouse the waypoint files describe. A path is metres in one scene's
# world frame, and the controller subtracts the file's origin from every pose, so
# the wrong set drives a valid-looking lane that was never validated in this
# scene — silently. Must be changed together with the config trio below.
#   20x20 (default_config_ros.yaml or _2fl.yaml)  -> ./waypoints/warehouse_20x20
#   40x20 (default_config_ros_40x20.yaml)         -> ./waypoints/warehouse_40x20
# preflight.py checks this against the trucks' spawn poses before Isaac boots.
FORKLIFT_WAYPOINTS_DIR=./waypoints/warehouse_20x20

# 40x20 two-dock variant (EXPERIMENTAL — no 40x20 calibration.json is published,
# so VSS runs 20x20 ROI/tripwire geometry against it and the SRR numbers do not
# mean anything; see robots-40x20.yaml note 6 and the scene<->calibration table
# in skills/hoisa-deploy-profile/references/test_scenario.md):
#   COMPOSE_PROFILES=sil,multi-robot
#   FORKLIFT_WAYPOINTS_DIR=./waypoints/warehouse_40x20
#   ./run_sdg.sh -c /isaac-sim/sil/configs/default_config_ros_40x20.yaml \
#     --robots-config /isaac-sim/sil/configs/robots-40x20.yaml \
#     --cameras-config /isaac-sim/sil/configs/cameras-40x20.yaml ...

MDX_SAMPLE_APPS_DIR=/path/to/halos-outside-in-safety # change me — repo checkout root
MDX_DATA_DIR=/path/to/sil-data # change me — local extract dir (ngc_artifacts.md §1)
MDX_DATA_RESOURCE=nvidia/halos-outside-in/sample-sil-data:v1.3.0 # NGC resource downloaded into MDX_DATA_DIR
HOST_IP='' # change me

# === VST ===
VST_BASE_URL=http://${HOST_IP}:30888/vst/api

# === Communication Layer ===
COMM_UDP_PORT=12346
COMM_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/safety/
COMM_ROS_TOPIC_PREFIX=/safety
COMM_LOG_DIR=${MDX_DATA_DIR}/comm-layer
# Robots that get their own /<id>/safety/is_muted alongside the global topic.
# The names must match `name` in the robots.yaml Isaac is launched with, and the
# list must be extended by hand when a robot is added — comm-layer also runs in
# HIL, where robots.yaml does not exist, so it cannot read the list from there.
# Every mirror carries the same value: PSF decides for a camera-covered zone,
# not for a named truck.
#
# Listing a robot the run does not have costs nothing but a topic with no
# subscriber, so both names are left on by default. Leaving one OUT is the
# expensive mistake: that truck's disc then sits on its alarm colour with
# nothing in any log. Verify with
#   ros2 topic info /forklift_b2/safety/is_muted   # want Publisher count: 1
#COMM_ROBOT_IDS=forklift_b
COMM_ROBOT_IDS=forklift_b,forklift_b2

# === ROS2 ===
ROS_DOMAIN_ID=0

# === PSF ===
PSF_IMAGE=nvcr.io/nvidia/halos-outside-in/outside-in-safety:nv-psf-halos-1.3-6932895
PSF_LAUNCH_MODE=skip  # skip = PSF without SAIM | learn = record SAIM sensor baselines | active = SAIM live (validates streams vs learned baselines)
PSF_CMD_RX_IP=127.0.0.1
PSF_LOG_DIR=${MDX_DATA_DIR}/psf-log

# === Isaac Sim ===
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.0
ISAAC_GPU_DEVICE=0
ISAAC_CACHE_DIR=${MDX_DATA_DIR}/isaac-cache
ISAAC_SIL_DIR=${MDX_SAMPLE_APPS_DIR}/closed-loop-testing/isaac-sim/sil

# === Perception model — 3D (Sparse4D) profile ONLY ===
# R101 Sparse4D: a VSS-side perception artifact (not consumed by this compose; pulled as a
# prerequisite, like MDX_DATA_RESOURCE). Download BOTH — deployable = inference ONNX,
# trainable = the kmeans anchor .npy — see references/model_r101.md. The 2D profile does NOT
# use these. Public NGC TAO catalog; both MUST be the same version.
R101_DEPLOYABLE_RESOURCE=nvidia/tao/sparse4d_rn101:deployable_v2.2  # inference ONNX
R101_TRAINABLE_RESOURCE=nvidia/tao/sparse4d_rn101:trainable_v2.2    # checkpoint + kmeans anchor .npy

# === Docker ===
DOCKER_GID=999 # change me — run: getent group docker | cut -d: -f3

# ROS 2 discovery scope for the SIL loop (all services on one host):
#   LOCALHOST = discover only on this host's loopback -- REQUIRED on cloud VMs (e.g. Brev)
#               that block UDP multicast, which otherwise breaks cyclonedds peer discovery
#               (Isaac <-> forklift-controller <-> comm-layer can't find each other).
#   SUBNET    = default (unset) behaviour: LAN-wide multicast discovery -- use for multi-host / HIL.
#   OFF       = disable automatic discovery entirely.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
