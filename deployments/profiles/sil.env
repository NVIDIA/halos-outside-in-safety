# SIL profile — x86 single-host, everything in Docker (incl. PSF x86). Self-contained.
# Usage:  cd deployments && docker compose --env-file profiles/sil.env up -d

COMPOSE_PROFILES=sil
# A second truck needs its own controller service, which this profile gates.
# Turn it on together with a two-forklift SCENARIO below — the profile decides
# whether the container exists, the scenario decides what it drives.
#COMPOSE_PROFILES=sil,multi-robot

# WHICH SCENARIO TO RUN. One id; Isaac and every controller read it, so they
# cannot end up on different halves of one run. The scenario names the IRA
# config, the fleet file, the cameras config and the warehouse — see
# closed-loop-testing/isaac-sim/sil/configs/scenarios.yaml.
#   warehouse_20x20_1fl  (default)  |  warehouse_40x20  (two trucks, experimental)
SCENARIO=warehouse_20x20_1fl

# Overrides the scenario's waypoint set for one run. A set from a different
# warehouse drives a lane nobody validated, and the truck moves the whole time
# — preflight.py --scene catches it, nothing else does.
#WAYPOINTS_MAP=warehouse_20x20

MDX_SAMPLE_APPS_DIR=/path/to/halos-outside-in-safety # change me — repo checkout root
MDX_DATA_DIR=/path/to/sil-data # change me — local extract dir (ngc_artifacts.md §1)
MDX_DATA_RESOURCE=nvidia/halos-outside-in/sample-sil-data:v1.3.0 # NGC resource downloaded into MDX_DATA_DIR
HOST_IP='' # change me

# === VST ===
VST_BASE_URL=http://${HOST_IP}:30888/vst/api

# === Communication Layer ===
COMM_UDP_PORT=12346
COMM_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/safety/
COMM_ROS_TOPIC_PREFIX=/safety
COMM_LOG_DIR=${MDX_DATA_DIR}/comm-layer
# comm-layer mirrors the mute onto /<id>/safety/is_muted for the robots the
# SCENARIO's fleet file asks for; nothing here lists them. Every mirror carries
# the same value: PSF decides for a camera-covered zone, not for a named truck.

# === ROS2 ===
ROS_DOMAIN_ID=0

# === PSF ===
PSF_IMAGE=nvcr.io/nvidia/halos-outside-in/outside-in-safety:<psf-1.4-tag>  # change me — PSF 1.4 image (configured SDMs, atl_dual); 1.3 images do not run these configs
PSF_LAUNCH_MODE=skip  # skip = PSF without SAIM | learn = record SAIM sensor baselines | active = SAIM live (validates streams vs learned baselines)
PSF_CMD_RX_IP=127.0.0.1
PSF_LOG_DIR=${MDX_DATA_DIR}/psf-log
# Which decision-maker PSF runs. atl = MUTE/UNMUTE for the trailer (default).
# pxc = proximity: NORMAL / REDUCE / STOP for a forklift next to a person, per
# safety-core/configs/proximity_event_mapping.pb.txt. Isaac reads it too: under
# pxc the indicator disks show the proximity level (green / orange / red), and
# the forklift-controller slows and stops the truck accordingly.
# both = the two side by side in one container; it needs the override file, so
# set COMPOSE_FILE together with it. The disk shows red / orange while proximity
# acts, otherwise green muted / yellow alarm.
# pxc and both are SIL-only, and expect the 3D (Sparse4D) feed below. Each app
# reads its event binding from configs/<app>_sdm.conf. both still runs the
# 1.3 launcher, which this PSF image refuses (no --config for the SDMs).
#PSF_APP=pxc
#PSF_APP=both
#COMPOSE_FILE=compose.yaml:../closed-loop-testing/safety-core/atl-pxc-override.yaml
# Two trailer bays, one ATL zone each (atl_dual), with PSF_APP left at atl: zone 2's
# SDM sends to its own port, and a robot with `safety_indicator.zone: 2` in the fleet
# file shows that zone's mute. Needs both bays' ROI and tripwire in the calibration.
#COMPOSE_FILE=compose.yaml:../closed-loop-testing/safety-core/atl-dual-override.yaml
#COMM_UDP_PORT_ZONE2=12347
# The 3D (Sparse4D) feed runs PSF with deploymentMode = 3D: events arrive under
# the BEV group bev-sensor-1, made of the three cameras of sensor_config.conf.
# Set both lines together. Relative to closed-loop-testing/safety-core/.
#PSF_NVPSS_CONFIG_SRC=./configs/nvpss_bev.conf
#PSF_SENSOR_PIPELINES_CONFIG_SRC=./configs/sensor_pipelines_config_bev.conf

# === Isaac Sim ===
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.1.0
ISAAC_GPU_DEVICE=0
ISAAC_CACHE_DIR=${MDX_DATA_DIR}/isaac-cache
ISAAC_SIL_DIR=${MDX_SAMPLE_APPS_DIR}/closed-loop-testing/isaac-sim/sil

# === Perception model — 3D (Sparse4D) profile ONLY ===
# R101 Sparse4D: a VSS-side perception artifact (not consumed by this compose; pulled as a
# prerequisite, like MDX_DATA_RESOURCE). Download BOTH — deployable = inference ONNX,
# trainable = the kmeans anchor .npy — see references/model_r101.md. The 2D profile does NOT
# use these. Public NGC TAO catalog; both MUST be the same version.
R101_DEPLOYABLE_RESOURCE=nvidia/tao/sparse4d_rn101:deployable_v2.2  # inference ONNX
R101_TRAINABLE_RESOURCE=nvidia/tao/sparse4d_rn101:trainable_v2.2    # checkpoint + kmeans anchor .npy

# === Docker ===
DOCKER_GID=999 # change me — run: getent group docker | cut -d: -f3

# ROS 2 discovery scope for the SIL loop (all services on one host):
#   LOCALHOST = discover only on this host's loopback -- REQUIRED on cloud VMs (e.g. Brev)
#               that block UDP multicast, which otherwise breaks cyclonedds peer discovery
#               (Isaac <-> forklift-controller <-> comm-layer can't find each other).
#   SUBNET    = default (unset) behaviour: LAN-wide multicast discovery -- use for multi-host / HIL.
#   OFF       = disable automatic discovery entirely.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
