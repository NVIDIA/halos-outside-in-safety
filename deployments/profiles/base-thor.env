# base profile — IGX Thor (aarch64). VSS Warehouse + Safety Core on the Thor device.
#
# NOT a compose profile. On Thor the Safety Core is hybrid (nv-psf container + host binaries
# orchestrated by launch_hoisa.sh) → launched by the helper script, not docker compose:
#   bash closed-loop-testing/scripts/launch_thor_safety.sh base-thor
# VSS Warehouse is deployed separately (vss-deploy-profile skill). The safety decision renders
# as the VST halo_safety overlay. See skills/hoisa-deploy-profile/references/halos_thor.md.

HOST_IP='' # change me — this Thor's IP

# === Safety Core image (nv-psf container, multi-arch arm64+amd64, one tag) ===
PSF_IMAGE=nvcr.io/nvidia/halos-outside-in/outside-in-safety:nv-psf-halos-1.3-6932895  # multi-arch; Docker auto-selects arm64 on Thor (same tag as x86 base.env)

# === Thor Safety Core package (NGC resource, downloaded once at setup; ngc_artifacts.md §4) ===
PSF_TEGRA_RESOURCE=nvidia/halos-outside-in/outside-in-safety:nv-psf-halos-1.3-aarch64-release-6932895-psf-tegra  # host binaries .deb (atl_sdm, launch_hoisa, safety_monitor)

# === SDM placement / launch mode ===
SDM_TARGET=ccplex        # where the SDM runs: ccplex = the Thor application cores
PSF_LAUNCH_MODE=active   # skip = PSF without SAIM | learn = record SAIM sensor baselines | active = SAIM live (validates streams vs learned baselines)

# === Safety command sink — the VST halo_safety overlay ===
PSF_CMD_RX_IP=127.0.0.1
PSF_CMD_RX_PORT=12345    # must equal halo_safety_udp_port in the VSS 2D vst_config.json (ships -1 / disabled)

# === Perception event bus + sensor list ===
KAFKA_BROKER=localhost:9092                                    # VSS Kafka on this Thor host
PSF_SENSOR_CONFIG=/opt/nvidia/psf/bin/sensor_config_thor.conf  # copy from closed-loop-testing/safety-core/configs/, fill VST URLs
